<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup is disabled at the application level (android:allowBackup="false"). These rules exist so
  that if backup is ever enabled, credential and token stores are excluded by default rather than
  by omission. See docs/SECURITY.md section 2.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sustream_secure_prefs.xml" />
        <exclude domain="sharedpref" path="sustream_secure_prefs" />
        <exclude domain="file" path="datastore/" />
        <exclude domain="database" path="sustream.db" />
        <exclude domain="database" path="sustream.db-shm" />
        <exclude domain="database" path="sustream.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sustream_secure_prefs.xml" />
        <exclude domain="sharedpref" path="sustream_secure_prefs" />
        <exclude domain="file" path="datastore/" />
        <exclude domain="database" path="sustream.db" />
    </device-transfer>
</data-extraction-rules>
