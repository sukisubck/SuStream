<?xml version="1.0" encoding="utf-8"?>
<!-- Launch window background: brand gradient so there is no white flash before first frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#FF0B0E14"
                android:centerColor="#FF12162A"
                android:endColor="#FF1A1740"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
